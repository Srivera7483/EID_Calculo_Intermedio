# =========================
# Ignorar salidas de Manim
# =========================
# Manim guarda todos los videos renderizados, imágenes y caché en esta carpeta.
# ¡Es crucial ignorarla para no saturar el repositorio!
media/
__pycache__/
*.pyc

# =========================
# Entornos virtuales
# =========================
# No subas las librerías instaladas, para eso existirá el requirements.txt
venv/
env/
.venv/

# =========================
# Archivos de entorno y secretos
# =========================
.env

# =========================
# Configuraciones de Editores/IDEs
# =========================
.vscode/
.idea/
*.swp

# =========================
# Archivos del Sistema Operativo
# =========================
.DS_Store
Thumbs.db